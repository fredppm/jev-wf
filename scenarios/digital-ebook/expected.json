{
  "orderGroupId": "og-digital-ebook",
  "workflows": [
    {
      "orderId": "og-digital-ebook-01",
      "mode": "jev",
      "start": "confirm_seller",
      "nodes": [
        {
          "id": "confirm_seller",
          "piece": "confirm_seller",
          "scope": "order",
          "publicStatus": "waiting_seller",
          "config": {
            "timeoutMinutes": 60
          }
        },
        {
          "id": "payment",
          "piece": "payment",
          "scope": "order",
          "publicStatus": "payment_pending",
          "config": {
            "timeoutMinutes": 30,
            "retries": 2
          }
        },
        {
          "id": "release_items",
          "piece": "release_items",
          "scope": "order",
          "publicStatus": "ready_for_handling"
        },
        {
          "id": "ebook1/deliver_digital",
          "piece": "deliver_digital",
          "scope": "item",
          "itemId": "ebook1",
          "publicStatus": "delivering"
        }
      ],
      "edges": [
        {
          "from": "confirm_seller",
          "port": "confirmed",
          "type": "order_confirmed",
          "to": "payment"
        },
        {
          "from": "confirm_seller",
          "port": "rejected",
          "type": "order_cancelled"
        },
        {
          "from": "confirm_seller",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "payment",
          "port": "approved",
          "type": "order_confirmed",
          "to": "release_items"
        },
        {
          "from": "payment",
          "port": "denied",
          "type": "order_cancelled"
        },
        {
          "from": "payment",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "release_items",
          "port": "released",
          "type": "item_released",
          "to": "ebook1/deliver_digital"
        },
        {
          "from": "release_items",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "ebook1/deliver_digital",
          "port": "delivered",
          "type": "item_completed"
        },
        {
          "from": "ebook1/deliver_digital",
          "port": "exception",
          "type": "manual_review_required"
        }
      ]
    }
  ]
}
