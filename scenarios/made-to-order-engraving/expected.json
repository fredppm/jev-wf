{
  "orderGroupId": "og-made-to-order-engraving",
  "workflows": [
    {
      "orderId": "og-made-to-order-engraving-01",
      "mode": "jev",
      "start": "confirm_seller",
      "nodes": [
        {
          "id": "confirm_seller",
          "piece": "confirm_seller",
          "scope": "order",
          "publicStatus": "waiting_seller",
          "config": {
            "timeoutMinutes": 60
          }
        },
        {
          "id": "payment",
          "piece": "payment",
          "scope": "order",
          "publicStatus": "payment_pending",
          "config": {
            "timeoutMinutes": 30,
            "retries": 2
          }
        },
        {
          "id": "release_items",
          "piece": "release_items",
          "scope": "order",
          "publicStatus": "ready_for_handling"
        },
        {
          "id": "nameplate1/produce_to_order",
          "piece": "produce_to_order",
          "scope": "item",
          "itemId": "nameplate1",
          "publicStatus": "in_production",
          "config": {
            "maxLeadTimeDays": 15
          }
        },
        {
          "id": "nameplate1/start_handling",
          "piece": "start_handling",
          "scope": "item",
          "itemId": "nameplate1",
          "publicStatus": "handling"
        },
        {
          "id": "nameplate1/issue_invoice",
          "piece": "issue_invoice",
          "scope": "item",
          "itemId": "nameplate1",
          "publicStatus": "invoicing"
        },
        {
          "id": "nameplate1/ship_standard",
          "piece": "ship_standard",
          "scope": "item",
          "itemId": "nameplate1",
          "publicStatus": "shipping",
          "config": {
            "groupBy": [
              "origin",
              "shippingMethod"
            ]
          }
        },
        {
          "id": "nameplate1/wait_delivery",
          "piece": "wait_delivery",
          "scope": "item",
          "itemId": "nameplate1",
          "publicStatus": "in_transit"
        },
        {
          "id": "nameplate1/close_without_return",
          "piece": "close_without_return",
          "scope": "item",
          "itemId": "nameplate1",
          "publicStatus": "delivered"
        },
        {
          "id": "nameplate1/reserve_stock",
          "piece": "reserve_stock",
          "scope": "item",
          "itemId": "nameplate1",
          "publicStatus": "sourcing",
          "config": {
            "strategy": "lowest_effective_lead_time"
          }
        },
        {
          "id": "nameplate1/wait_restock",
          "piece": "wait_restock",
          "scope": "item",
          "itemId": "nameplate1",
          "publicStatus": "waiting_restock",
          "config": {
            "maxWaitDays": 15
          }
        }
      ],
      "edges": [
        {
          "from": "confirm_seller",
          "port": "confirmed",
          "type": "order_confirmed",
          "to": "payment"
        },
        {
          "from": "confirm_seller",
          "port": "rejected",
          "type": "order_cancelled"
        },
        {
          "from": "confirm_seller",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "payment",
          "port": "approved",
          "type": "order_confirmed",
          "to": "release_items"
        },
        {
          "from": "payment",
          "port": "denied",
          "type": "order_cancelled"
        },
        {
          "from": "payment",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "release_items",
          "port": "released",
          "type": "item_released",
          "to": "nameplate1/produce_to_order"
        },
        {
          "from": "release_items",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "nameplate1/produce_to_order",
          "port": "produced",
          "type": "stock_reserved",
          "to": "nameplate1/start_handling"
        },
        {
          "from": "nameplate1/produce_to_order",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "nameplate1/start_handling",
          "port": "ready",
          "type": "ready_to_ship",
          "to": "nameplate1/issue_invoice"
        },
        {
          "from": "nameplate1/start_handling",
          "port": "exception",
          "type": "resourcing_required",
          "to": "nameplate1/reserve_stock"
        },
        {
          "from": "nameplate1/issue_invoice",
          "port": "issued",
          "type": "ready_to_ship",
          "to": "nameplate1/ship_standard"
        },
        {
          "from": "nameplate1/issue_invoice",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "nameplate1/ship_standard",
          "port": "shipped",
          "type": "in_transit",
          "to": "nameplate1/wait_delivery"
        },
        {
          "from": "nameplate1/ship_standard",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "nameplate1/wait_delivery",
          "port": "delivered",
          "type": "item_delivered",
          "to": "nameplate1/close_without_return"
        },
        {
          "from": "nameplate1/wait_delivery",
          "port": "exception",
          "type": "resourcing_required",
          "to": "nameplate1/reserve_stock"
        },
        {
          "from": "nameplate1/close_without_return",
          "port": "closed",
          "type": "item_completed"
        },
        {
          "from": "nameplate1/close_without_return",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "nameplate1/reserve_stock",
          "port": "reserved",
          "type": "stock_reserved",
          "to": "nameplate1/start_handling"
        },
        {
          "from": "nameplate1/reserve_stock",
          "port": "no_stock",
          "type": "awaiting_restock",
          "to": "nameplate1/wait_restock"
        },
        {
          "from": "nameplate1/reserve_stock",
          "port": "exception",
          "type": "manual_review_required"
        },
        {
          "from": "nameplate1/wait_restock",
          "port": "restocked",
          "type": "restock_received",
          "to": "nameplate1/reserve_stock"
        },
        {
          "from": "nameplate1/wait_restock",
          "port": "expired",
          "type": "item_cancelled"
        },
        {
          "from": "nameplate1/wait_restock",
          "port": "exception",
          "type": "manual_review_required"
        }
      ]
    }
  ]
}
